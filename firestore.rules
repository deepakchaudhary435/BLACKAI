rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSupportAdmin() {
      return signedIn()
        && request.auth.uid == 'YbAdMPt1pYP74CzKCSNnCmmyTG73';
    }

    match /supportTickets/{ticketId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'userId', 'message', 'createdAt', 'status', 'priority',
          'adminReply', 'adminReplyAt'
        ])
        && request.resource.data.keys().hasAll([
          'userId', 'message', 'createdAt', 'status', 'priority',
          'adminReply', 'adminReplyAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 2000
        && request.resource.data.createdAt is number
        && request.resource.data.status == 'Pending'
        && request.resource.data.priority == 'Medium'
        && request.resource.data.adminReply == ''
        && request.resource.data.adminReplyAt == 0;

      // Firestore enforces query constraints: normal users must query only their own userId.
      allow get, list: if signedIn()
        && (resource.data.userId == request.auth.uid || isSupportAdmin());

      allow update: if isSupportAdmin()
        && request.resource.data.keys().hasOnly([
          'userId', 'message', 'createdAt', 'status', 'priority',
          'adminReply', 'adminReplyAt'
        ])
        && request.resource.data.keys().hasAll([
          'userId', 'message', 'createdAt', 'status', 'priority',
          'adminReply', 'adminReplyAt'
        ])
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.message == resource.data.message
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in ['Pending', 'In Progress', 'Solved', 'Closed']
        && request.resource.data.priority in ['High', 'Medium', 'Low']
        && request.resource.data.adminReply is string
        && request.resource.data.adminReply.size() <= 2000
        && request.resource.data.adminReplyAt is number;

      allow delete: if isSupportAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
